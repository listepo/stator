{
  "minTokens": 50,
  "minLines": 5,
  "mode": "strict",
  "crossFormats": "js-ts",
  "reporters": ["ai"],
  "threshold": 1,
  "ignore": [
    "**/.claude/worktrees/**",
    "**/.moon/cache/**",
    "**/node_modules/**",
    "**/dist/**",
    "coverage/**",
    "packages/runtime/build*/**",
    "packages/runtime/vendor/**",
    "packages/tests/subset/subset_*",
    "packages/tests/subset/helper_*",
    "packages/tests/subset/cycle_partner_*",
    "packages/tests/golden/ts/**",
    "packages/tests/golden/js/**",
    "packages/tests/differential/corpus/**",
    "packages/tests/differential/failures/**",
    "docs/architecture/**"
  ]
}
