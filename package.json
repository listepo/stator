{
  "name": "stator",
  "version": "0.0.0",
  "private": true,
  "description": "Stator — an ahead-of-time compiler from TypeScript/JavaScript to native binaries (monorepo root)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/compiler/tsconfig.json && tsc --noEmit -p packages/tests/tsconfig.json && tsc --noEmit -p packages/std/tsconfig.json",
    "build": "tsc -p packages/compiler/tsconfig.json",
    "lint": "oxlint --deny-warnings . && oxfmt --check \"**/*.{ts,tsx,js,mjs,cjs,json,jsonc}\"",
    "format": "oxlint --fix . && oxfmt \"**/*.{ts,tsx,js,mjs,cjs,json,jsonc}\"",
    "test": "vitest run --config packages/tests/vitest.config.ts",
    "test:affected": "vitest run --config packages/tests/vitest.config.ts --changed",
    "test:coverage": "c8 vitest run --config packages/tests/vitest.config.ts",
    "test:subset": "node packages/tests/subset/run.ts",
    "test:golden": "node packages/tests/golden/run.ts",
    "test262": "node packages/tests/test262/run.ts",
    "test262:fetch": "node packages/tests/test262/fetch.ts",
    "differential": "node packages/tests/differential/run.ts",
    "bench:record": "node packages/tests/bench/record.ts",
    "test:runtime": "just -f packages/runtime/justfile -d packages/runtime runtime-test",
    "test:leak": "node packages/tests/leak/run.ts",
    "test:asan": "node packages/tests/golden/asan-gate.ts",
    "test:ffi": "node packages/tests/ffi/run.ts",
    "test:intl": "just -f packages/runtime/justfile -d packages/runtime runtime-intl && just -f packages/std/justfile -d packages/std std && STATOR_RUNTIME=intl node packages/tests/golden/run.ts",
    "runtime": "just -f packages/runtime/justfile -d packages/runtime runtime && just -f packages/std/justfile -d packages/std std",
    "vendor:update": "node packages/runtime/vendor/update.mjs",
    "dupes": "cpd .",
    "dupes:baseline": "cpd . --update-baseline",
    "ci": "node scripts/check-node.mjs && pnpm run typecheck && pnpm run lint && pnpm run dupes && pnpm run runtime && pnpm run test && pnpm run test:runtime && pnpm run test:subset && pnpm run test:golden && pnpm run test:builtins && pnpm run test:node-coverage && pnpm run test:leak && pnpm run test:asan",
    "test:builtins": "node packages/tests/golden/builtins.ts",
    "docs:node": "node packages/tests/golden/node-coverage.ts",
    "test:node-coverage": "node packages/tests/golden/node-coverage.ts --check"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "c8": "12.0.0",
    "cpd": "5.3.0",
    "dotenv": "18.0.1",
    "execa": "10.0.1",
    "ink": "7.1.1",
    "memfs": "4.78.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
