{
  "name": "stator",
  "version": "0.0.0",
  "private": true,
  "description": "Stator — an ahead-of-time compiler from TypeScript/JavaScript to native binaries (monorepo root)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/compiler/tsconfig.json && tsc --noEmit -p packages/tests/tsconfig.json",
    "build": "tsc -p packages/compiler/tsconfig.json",
    "lint": "oxlint --deny-warnings . && oxfmt --check \"**/*.{ts,tsx,js,mjs,cjs,json,jsonc}\"",
    "format": "oxlint --fix . && oxfmt \"**/*.{ts,tsx,js,mjs,cjs,json,jsonc}\"",
    "test": "node --test \"packages/tests/unit/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include=\"packages/compiler/src/**\" --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info \"packages/tests/unit/*.test.ts\"",
    "test:subset": "node packages/tests/subset/run.ts",
    "test:golden": "node packages/tests/golden/run.ts",
    "test262": "node packages/tests/test262/run.ts",
    "test262:fetch": "node packages/tests/test262/fetch.ts",
    "differential": "node packages/tests/differential/run.ts",
    "bench:record": "node packages/tests/bench/record.ts",
    "test:runtime": "just -f packages/runtime/justfile -d packages/runtime runtime-test",
    "test:leak": "node packages/tests/leak/run.ts",
    "test:asan": "node packages/tests/golden/asan-gate.ts",
    "test:ffi": "node packages/tests/ffi/run.ts",
    "test:intl": "just -f packages/runtime/justfile -d packages/runtime runtime-intl && STATOR_RUNTIME=intl node packages/tests/golden/run.ts",
    "runtime": "just -f packages/runtime/justfile -d packages/runtime runtime",
    "vendor:update": "node packages/runtime/vendor/update.mjs",
    "dupes": "cpd .",
    "ci": "node scripts/check-node.mjs && pnpm run typecheck && pnpm run lint && pnpm run dupes && pnpm run runtime && pnpm run test && pnpm run test:runtime && pnpm run test:subset && pnpm run test:golden && pnpm run test:builtins && pnpm run test:leak && pnpm run test:asan",
    "test:builtins": "node packages/tests/golden/builtins.ts"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "cpd": "5.2.0",
    "dotenv": "18.0.1",
    "execa": "10.0.1",
    "ink": "7.1.1",
    "memfs": "4.76.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
