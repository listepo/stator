---
// Self-hosted IBM Plex (OFL-1.1, via Fontsource): no request leaves the site's origin.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import { THEME_BOOT } from '../scripts/theme-boot.ts';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'stator — TS/JS → native', description = 'stator: ahead-of-time TypeScript/JavaScript to native binaries.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    {/* Apply the stored theme before first paint to avoid FOUC (src/scripts/theme-boot.ts).
       These scripts open <body>
       rather than sit in <head> because Astro injects its CSP <meta> at the end of <head>, and
       a meta policy governs only the elements after it: in <head> the boot script would run
       before the policy that hashes it exists. A parser-blocking script here still runs
       before anything below it paints. */}
    <script is:inline set:html={THEME_BOOT} />
    <script defer src={`${base}js/theme.js`}></script>
    <slot />
  </body>
</html>
