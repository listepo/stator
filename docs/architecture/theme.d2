# Shared theme for architecture views. Imported with `...@theme`.
# Light Neutral Grey so the SVGs read on GitHub's default background.

vars: {
  d2-config: {
    theme-id: 1
    pad: 40
  }
}

classes: {
  gate: {
    style.fill: "#fde68a"
    style.bold: true
  }
  fast: {
    style.fill: "#bbf7d0"
  }
  boxed: {
    style.fill: "#fde68a"
  }
  err: {
    style.fill: "#fecaca"
  }
  bin: {
    style.fill: "#bbf7d0"
  }
}
